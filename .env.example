# Copy to .env and adjust. start_app.bat does this automatically on first run.

# --- Database ---
POSTGRES_DB=payments_tracker
POSTGRES_USER=payments
POSTGRES_PASSWORD=payments

# --- Django ---
# Generate a long random value for production, e.g.:
#   python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=local-dev-secret-change-me
DJANGO_DEBUG=0
DJANGO_ALLOWED_HOSTS=*
# localhost on APP_PORT is trusted automatically. Add extra addresses here,
# e.g. to open the app from your phone: http://192.168.1.25:8010
DJANGO_CSRF_TRUSTED_ORIGINS=
DJANGO_SECURE=0

# Load demo doctors/hospitals/cases on first start (skipped if cases exist).
SEED_DEMO_DATA=1

# Optional: create your own admin login on start-up.
DJANGO_SUPERUSER_USERNAME=
DJANGO_SUPERUSER_PASSWORD=
DJANGO_SUPERUSER_EMAIL=

# Port on your computer (http://localhost:8010). start_app.bat changes this
# automatically if another program is already using the port.
APP_PORT=8010

# --- Production only (docker-compose.prod.yml) ---
# APP_DOMAIN=payments.yourdomain.com
# DJANGO_ALLOWED_HOSTS=payments.yourdomain.com
# DJANGO_CSRF_TRUSTED_ORIGINS=https://payments.yourdomain.com
# DJANGO_SECURE=1
# SEED_DEMO_DATA=0
